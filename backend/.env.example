# CogniFlow 环境配置（复制为 .env 后填写真实值）

# ── 基础设施（软路由 192.168.100.1 上的 docker 服务）────────────────
DATABASE_URL=<填你的>
REDIS_URL=<填你的>
# 路由上 redis 启用了 requirepass；有密码时把上面改成：
# REDIS_URL=redis://:<密码>@192.168.100.1:6379/1

# ── Chat 模型（LangChain 对接 OpenAI 兼容端点）─────────────────────
# langchain_openai 为默认实现；openai_compat 保留为低层 SDK 降级实现。
CHAT_PROVIDER=langchain_openai
# 百炼 API Key。留空时系统会明确报“未配置”，不要填写示例或其他平台的密钥。
CHAT_API_KEY=
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_TIMEOUT_S=30
# Qwen3.7 默认会思考；客服意图识别/工具调用要求低延迟和稳定结构化输出，建议关闭。
CHAT_ENABLE_THINKING=false
LLM_MODEL_DEFAULT=qwen3.7-flash
LLM_MODEL_INTENT=qwen3.7-flash
LLM_MODEL_SUMMARY=qwen3.7-flash
LLM_MODEL_PRE_SALES=qwen3.7-flash
LLM_MODEL_DURING_SALES=qwen3.7-flash
LLM_MODEL_AFTER_SALES=qwen3.7-flash
LLM_MODEL_COMPLAINT=qwen3.7-flash

# ── Embedding ──────────────────────────────────────────────────────
# openai_compat = 走百炼；离线联调/单测可用 hash（非语义，勿用于真实评测结论）
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024

# ── Rerank（DashScope 原生端点，非 OpenAI 兼容路径）─────────────────
# dashscope | noop；gte-rerank-v2 已于 2026-05-30 下线，用 qwen3-rerank
RERANK_PROVIDER=dashscope
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank
RERANK_TOP_N=5

# ── 向量库：三选一，代码按 MILVUS_ENDPOINT 是否填写自动切换 ──────────
# A. Milvus Lite（默认，嵌入式本地文件；Windows 与 ARM64 实测可跑）
MILVUS_LITE_PATH=data/milvus.db
# B. Zilliz Cloud / 独立 Milvus Server：取消注释并填写，A 自动失效
# MILVUS_ENDPOINT=https://in03-xxxxxxxx.gcp-us-west1.zillizcloud.com
# MILVUS_TOKEN=<api key 或 username:password>
# MILVUS_DB_NAME=<database 名，选填>
MILVUS_COLLECTION=knowledge_chunks

# ── Agent / 检索参数（有默认值，按需覆盖）───────────────────────────
TOOL_TIMEOUT_MS=5000
TOOL_RETRY_COUNT=3
MAX_TOOL_ROUNDS=3
MAX_COLLABORATION_AGENTS=2
MAX_CONVERSATION_TURNS=10
SUMMARY_TRIGGER_TURNS=8
RETRIEVAL_TOP_K=5
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
# 向量候选相似度下限；换 embedding 模型必须重新标定（当前值按 40 条评测集标定）
SIMILARITY_THRESHOLD=0.5

# ── 后台鉴权 ──────────────────────────────────────────────────────────
# JWT 签名密钥。留空会用开发默认密钥并在启动时告警——上生产必须显式生成：
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_TTL_S=28800
# 首次启动引导出的后台账号（已存在则不覆盖口令）
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ── 服务监听 / 日志 ──────────────────────────────────────────────────
# Windows 下请用 `python run.py` 启动（直接 uvicorn 命令行会踩 Proactor 事件循环）
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=0
LOG_LEVEL=INFO
COGNIFLOW_LOG_FORMAT=%(asctime)s %(levelname)-7s %(name)s [%(trace)s] %(message)s
